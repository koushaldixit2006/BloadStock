# BloodStock Spring Boot Environment Variables
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/bloodstock_spring?replicaSet=rs0
OPTIMIZER_URL=http://127.0.0.1:8000
INTERNAL_SECRET=bloodstock-dev-secret-key-32chars-min
JWT_SECRET=super-secret-jwt-key-for-bloodstock-planning-token-32c
JWT_REFRESH_SECRET=super-secret-refresh-key-for-bloodstock-planning-token-32c
SHARED_RULES_PATH=../shared/rules.json
CORS_ORIGIN=http://localhost:5173

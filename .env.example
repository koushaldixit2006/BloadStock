# BloodStock Environment Variables
PORT=3001
NODE_ENV=development

# MongoDB Replica Set connection string (required for transactions)
MONGODB_URI=mongodb://mongo:27017/bloodstock?replicaSet=rs0

# Optimizer microservice URL and authentication
OPTIMIZER_URL=http://optimizer:8000
INTERNAL_SECRET=bloodstock-dev-secret-key-32chars-min

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-bloodstock-planning-token-32c
JWT_EXPIRES_IN=24h

# Shared Rules Path
SHARED_RULES_PATH=/shared/rules.json
